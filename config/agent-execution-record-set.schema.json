{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": "agent-execution-record-set-v1" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "roleId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "roleId": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version", "reference"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {
          "enum": [
            "produced",
            "approved",
            "adjustments-required",
            "blocked",
            "failed"
          ]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "reference", "observedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "agent-output",
            "command-output",
            "document",
            "link",
            "test-result"
          ]
        },
        "reference": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "criterion",
        "summary",
        "evidenceIds",
        "recommendation",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["blocking", "major", "minor", "info"] },
        "criterion": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "recommendation": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "origin", "url", "consultedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "publishedAt": { "type": "string", "format": "date" },
        "consultedAt": { "type": "string", "format": "date" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "statement", "sourceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": ["fact", "inference", "hypothesis", "recommendation"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "audience",
        "decisionOwner",
        "sources",
        "claims",
        "recommendation",
        "confidence"
      ],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "decisionOwner": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim" }
        },
        "recommendation": {
          "enum": ["discard", "observe", "research", "propose-backlog"]
        },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "executionId",
        "workItemId",
        "recordedAt",
        "actor",
        "capabilityId",
        "artifact",
        "outcome",
        "evidence",
        "findings",
        "humanDecisionRequired"
      ],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "executionId": { "type": "string", "minLength": 1 },
        "workItemId": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/actor" },
        "capabilityId": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/artifact" },
        "subjectExecutionId": { "type": "string", "minLength": 1 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "research": { "$ref": "#/$defs/research" },
        "humanDecisionRequired": { "const": true }
      }
    }
  }
}
