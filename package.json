{
  "name": "quiz",
  "version": "1.0.0",
  "description": "> Aplicacao web de quiz educativo para criancas do 3o ano do Ensino Fundamental, com foco em pratica, revisao e acompanhamento de desempenho.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "start": "node scripts/dev-server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run validate:agents && npm run test:editorial-runner && npm run test:branch-policy && npm run validate:content && npm run test:content && npm run test:ui:content-session && npm run test:ui:dark-mode && npm run test:ui:critical-rules && npm run test:ui:trimester-history-selector && npm run test:ui:question-count-selector && npm run test:ui:geography-language-audit && npm run test:ui:english-language-audit && npm run test:ui:portuguese-language-audit && npm run test:ui:panel-base",
    "validate:agents": "node scripts/validate-codex-agents.cjs && node tests/agents/codex-agent-validator.spec.cjs",
    "test:editorial-runner": "node tests/agents/editorial-agent-runner.spec.cjs",
    "validate:branch": "node scripts/validate-branch-policy.cjs",
    "validate:branch-sync": "node scripts/validate-branch-sync.cjs",
    "validate:content": "node scripts/validate-content.cjs",
    "test:branch-policy": "node tests/governance/branch-policy.spec.cjs && node tests/governance/branch-sync.spec.cjs",
    "test:content": "node tests/content/content-validator.spec.cjs && node tests/content/content-coverage-validator.spec.cjs",
    "test:ui:content-session": "node tests/ui/content-session.spec.cjs",
    "test:ui:dark-mode": "node tests/ui/dark-mode.spec.cjs",
    "test:ui:critical-rules": "node tests/ui/critical-rules.spec.cjs",
    "test:ui:trimester-history-selector": "node tests/ui/trimester-history-selector.spec.cjs",
    "test:ui:question-count-selector": "node tests/ui/question-count-selector.spec.cjs",
    "test:ui:geography-language-audit": "node tests/ui/geography-language-audit.spec.cjs",
    "test:ui:english-language-audit": "node tests/ui/english-language-audit.spec.cjs",
    "test:ui:portuguese-language-audit": "node tests/ui/portuguese-language-audit.spec.cjs",
    "test:ui:panel-base": "node tests/ui/panel-base.spec.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dleomil/quiz.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dleomil/quiz/issues"
  },
  "homepage": "https://github.com/dleomil/quiz#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3"
  }
}
