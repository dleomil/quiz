  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dleomil/quiz/issues"
  },
  "homepage": "https://github.com/dleomil/quiz#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3"
  }
